# ==============================================================================
# Homework Helper — Environment Configuration Template
# Copy this file to .env.local for local development. Never commit real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Provider: Google Gemini
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Model identifier (defaults to gemini-flash-lite-latest for fast, low-latency parent responses)
# Supported: gemini-flash-lite-latest, gemini-3.5-flash, gemini-3.8-flash, gemini-flash-latest
AI_MODEL="gemini-flash-lite-latest"

# ------------------------------------------------------------------------------
# 2. Secondary / Fallback AI Provider: OpenAI-Compatible (Optional)
# ------------------------------------------------------------------------------
# Used as secondary fallback if Gemini experiences regional downtime or rate-limits
# AI_API_BASE_URL="https://api.bazaarlink.ai/v1"
# AI_API_KEY="your_openai_compatible_api_key_here"

# ------------------------------------------------------------------------------
# 3. Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Maximum content generation requests allowed per IP window (default: 15)
RATE_LIMIT_MAX_REQUESTS=15

# Sliding rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Distributed Serverless Rate Limiting via Upstash Redis (Optional for Vercel/Edge)
# If left unset, the application automatically uses in-memory sliding window rate limiting.
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"
