{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Homework Helper Generated Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "grade",
    "subject",
    "parent_summary",
    "intuition",
    "steps",
    "common_mistakes",
    "kid_script",
    "problems"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parent_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "intuition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "common_mistakes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "kid_script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "problems": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "difficulty",
          "question",
          "hint",
          "answer",
          "solution_steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "easy-medium",
              "medium",
              "medium-hard",
              "challenge"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "solution_steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}